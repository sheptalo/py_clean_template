{
  "$defs": {
    "EndpointSpec": {
      "additionalProperties": false,
      "properties": {
        "method": {
          "enum": [
            "GET",
            "POST",
            "PUT",
            "PATCH",
            "DELETE"
          ],
          "title": "Method",
          "type": "string"
        },
        "path": {
          "default": "",
          "title": "Path",
          "type": "string"
        },
        "status": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Status"
        },
        "auth": {
          "default": "none",
          "enum": [
            "none",
            "optional",
            "required"
          ],
          "title": "Auth",
          "type": "string"
        },
        "summary": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Summary"
        },
        "use_case": {
          "$ref": "#/$defs/UseCaseSpec"
        },
        "request": {
          "$ref": "#/$defs/RequestSpec"
        },
        "input": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Input",
          "type": "object"
        },
        "response": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "$ref": "#/$defs/ResponseSpec"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Response"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        }
      },
      "required": [
        "method",
        "use_case"
      ],
      "title": "EndpointSpec",
      "type": "object"
    },
    "FileSpec": {
      "additionalProperties": false,
      "properties": {
        "content": {
          "title": "Content",
          "type": "string"
        },
        "filename": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Filename"
        },
        "media_type": {
          "default": "application/octet-stream",
          "title": "Media Type",
          "type": "string"
        }
      },
      "required": [
        "content"
      ],
      "title": "FileSpec",
      "type": "object"
    },
    "RequestSpec": {
      "additionalProperties": false,
      "description": "Request sources. A parameter without a type takes it from the mapped DTO field.",
      "properties": {
        "body": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Body"
        },
        "path": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Path",
          "type": "object"
        },
        "query": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Query",
          "type": "object"
        },
        "header": {
          "additionalProperties": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "title": "Header",
          "type": "object"
        }
      },
      "title": "RequestSpec",
      "type": "object"
    },
    "ResponseSpec": {
      "additionalProperties": false,
      "properties": {
        "file": {
          "$ref": "#/$defs/FileSpec"
        }
      },
      "required": [
        "file"
      ],
      "title": "ResponseSpec",
      "type": "object"
    },
    "UseCaseSpec": {
      "additionalProperties": false,
      "properties": {
        "input": {
          "title": "Input",
          "type": "string"
        },
        "output": {
          "title": "Output",
          "type": "string"
        }
      },
      "required": [
        "input",
        "output"
      ],
      "title": "UseCaseSpec",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1,
      "title": "Version",
      "type": "integer"
    },
    "prefix": {
      "default": "",
      "title": "Prefix",
      "type": "string"
    },
    "tags": {
      "items": {
        "type": "string"
      },
      "title": "Tags",
      "type": "array"
    },
    "schemas": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "string"
        },
        "type": "object"
      },
      "title": "Schemas",
      "type": "object"
    },
    "errors": {
      "additionalProperties": {
        "type": "integer"
      },
      "title": "Errors",
      "type": "object"
    },
    "endpoints": {
      "additionalProperties": {
        "$ref": "#/$defs/EndpointSpec"
      },
      "title": "Endpoints",
      "type": "object"
    }
  },
  "required": [
    "version"
  ],
  "title": "RouterSpec",
  "type": "object"
}
