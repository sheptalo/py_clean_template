[project]
name = "{{ project_name }}"
version = "0.1.0"
description = ""
authors = [
    { name = "sinortax", email = "github@sinortax.ru" }
]
requires-python = ">=3.14"
dependencies = [
    "pydantic-settings>=2.15.0",
    {% if include_fastapi %}"fastapi>=0.141.1",{% endif %}
    {% if include_fastapi %}"uvicorn>=0.52.4",{% endif %}
    {% if include_dishka %}"dishka>=1.10.1",{% endif %}
]
{% if include_fastapi and include_dishka %}
[project.scripts]
api = "composition.api:main"
{% endif %}
[build-system]
requires = ["uv_build>=0.12.5,<0.13.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = ["{{ project_name }}", "composition"]
module-root = ""

[dependency-groups]
dev = [
    "mypy>=2.3.1",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "ruff>=0.16.6",
    "import-linter>=2.15",
{% if include_codegen %}    "pyyaml>=6.0.3",
    "types-pyyaml>=6.0.12",
{% endif %}]

[tool.ruff]
line-length = 120
indent-width = 4
target-version = "py314"
exclude = [
    ".bzr",
    ".direnv",
    ".eggs",
    ".git",
    ".git-rewrite",
    ".hg",
    ".ipynb_checkpoints",
    ".mypy_cache",
    ".nox",
    ".pants.d",
    ".pyenv",
    ".pytest_cache",
    ".pytype",
    ".ruff_cache",
    ".svn",
    ".tox",
    ".venv",
    ".vscode",
    "__pypackages__",
    "_build",
    "buck-out",
    "build",
    "dist",
    "node_modules",
    "site-packages",
    "venv",
]

[tool.ruff.format]
quote-style = "double"
indent-style = "space"
skip-magic-trailing-comma = false
line-ending = "auto"
docstring-code-format = false

[tool.ruff.lint]
select = [
    "A",
    "B",
    "BLE",
    "S",
    "ARG",
    "ISC",
    "E",
    "F",
    "FURB",
    "G",
    "I",
    "ICN",
    "INP",
    "N",
    "PLW",
    "RUF",
    "T",
    "TID",
    "UP",
    "W",
    "ERA",
    "ASYNC",
    "SIM",
    "TD001",
    "TD002",
    "PL",
    "DTZ",
    "PT",
    "C",
    "TRY",
    "ANN",
    "PTH",
    "PGH",
    "FLY",
    "PIE",
    "RET",
    "RSE",
    "SLF",
    "T10",
    "YTT",
    "PERF",
    "LOG"
]
ignore = []
fixable = ["ALL"]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101"]
{% if include_codegen %}"tools/**" = ["ANN401", "TRY003"]
"tools/codegen/__main__.py" = ["ANN401", "T201", "TRY003"]
{% endif %}".claude/**" = ["INP001"]

[tool.ruff.lint.pylint]
max-returns = 5

[tool.mypy]
plugins = ["pydantic.mypy"]
disallow_untyped_defs = true
disallow_incomplete_defs = true
warn_redundant_casts = true
warn_unreachable = true
explicit_package_bases = false
disallow_any_unimported = true
no_implicit_optional = true
check_untyped_defs = true
warn_return_any = true
show_error_codes = true
warn_unused_ignores = true
disallow_untyped_calls = true
strict_equality = true
warn_unused_configs = true
extra_checks = true
enable_error_code = ["ignore-without-code", "truthy-bool", "redundant-expr"]


[tool.importlinter]
root_package = "{{ project_name }}"

[[tool.importlinter.contracts]]
name = "Clean Architecture"
type = "layers"
layers = [
    "{{ project_name }}.presentation",
    "{{ project_name }}.infrastructure",
    "{{ project_name }}.application",
    "{{ project_name }}.domain",
]

[tool.coverage.run]
source = ["{{ project_name }}"]
branch = true
omit = ["*/tests/*"]

[tool.coverage.report]
show_missing = true
exclude_lines = [
    "pragma: no cover",
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]
