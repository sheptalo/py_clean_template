[project]
name = "{{ project_name }}"
version = "0.1.0"
description = ""
authors = [
    { name = "sinortax", email = "github@sinortax.ru" }
]
requires-python = ">=3.14"
dependencies = [
    "pydantic-settings>=2.15.0",
{% if include_fastapi %}    "fastapi>=0.141.1",
    "uvicorn>=0.52.4",
{% endif %}{% if include_dishka %}    "dishka>=1.10.1",
{% endif %}]
{% if include_fastapi and include_dishka %}
[project.scripts]
api = "composition.api:main"
{% endif %}
[build-system]
requires = ["uv_build>=0.12.5,<0.13.0"]
build-backend = "uv_build"

[tool.uv.build-backend]
module-name = ["{{ project_name }}", "composition"]
module-root = ""

[dependency-groups]
dev = [
    "anyio>=4.15.1",
    "mypy>=2.3.1",
    "pre-commit>=4.4.0",
    "pytest>=9.1.1",
    "pytest-cov>=7.1.0",
    "ruff>=0.16.6",
    "import-linter>=2.15",
{% if include_fastapi %}    "httpx2>=2.13.0",
{% endif %}{% if include_codegen %}    "pyyaml>=6.0.3",
    "types-pyyaml>=6.0.12",
{% endif %}]

[tool.ruff]
line-length = 120

[tool.ruff.lint]
select = [
    "A",
    "B",
    "BLE",
    "S",
    "ARG",
    "ISC",
    "E",
    "F",
    "FURB",
    "G",
    "I",
    "ICN",
    "INP",
    "N",
    "RUF",
    "T",
    "TID",
    "UP",
    "W",
    "ERA",
    "ASYNC",
    "SIM",
    "TD001",
    "TD002",
    "PL",
    "DTZ",
    "PT",
    "C",
    "TRY",
    "ANN",
    "PTH",
    "PGH",
    "FLY",
    "PIE",
    "RET",
    "RSE",
    "SLF",
    "YTT",
    "PERF",
    "LOG"
]

[tool.ruff.lint.per-file-ignores]
"tests/**" = ["S101", "PLR2004"]
"composition/**" = ["T201"]
{% if include_codegen %}"tools/**" = ["ANN401", "TRY003"]
"tools/codegen/__main__.py" = ["ANN401", "T201", "TRY003"]
{% endif %}".claude/**" = ["INP001"]

[tool.ruff.lint.isort]
known-first-party = ["{{ project_name }}"]
sections = { composition = ["composition"] }
section-order = ["future", "standard-library", "third-party", "composition", "first-party", "local-folder"]

[tool.ruff.lint.pylint]
max-returns = 5

[tool.mypy]
plugins = ["pydantic.mypy"]
strict = true
warn_unused_configs = true
warn_unreachable = true
disallow_any_unimported = true
enable_error_code = ["ignore-without-code", "truthy-bool", "redundant-expr"]

[tool.importlinter]
root_package = "{{ project_name }}"

[[tool.importlinter.contracts]]
name = "Clean Architecture"
type = "layers"
layers = [
    "{{ project_name }}.presentation | {{ project_name }}.infrastructure",
    "{{ project_name }}.application",
    "{{ project_name }}.domain",
]

[[tool.importlinter.contracts]]
name = "Presentation sees only domain exceptions and constants"
type = "forbidden"
source_modules = ["{{ project_name }}.presentation"]
forbidden_modules = ["{{ project_name }}.domain"]
ignore_imports = [
    "{{ project_name }}.presentation.** -> {{ project_name }}.domain.exceptions",
    "{{ project_name }}.presentation.** -> {{ project_name }}.domain.constants",
    "{{ project_name }}.presentation.** -> {{ project_name }}.domain.constants.**",
]
unmatched_ignore_imports_alerting = "none"
allow_indirect_imports = true
{% if include_codegen %}
[tool.codegen]
fastapi = {{ 'true' if codegen_fastapi else 'false' }}
{% endif %}
[tool.pytest.ini_options]
markers = ["integration: needs real external services; run in CI or by hand, not by pre-commit"]

[tool.coverage.run]
source = ["{{ project_name }}"]
branch = true

[tool.coverage.report]
show_missing = true
exclude_also = [
    "if TYPE_CHECKING:",
    "raise NotImplementedError",
]
