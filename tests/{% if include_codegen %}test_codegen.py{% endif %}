from pathlib import Path

import pytest

from tools.codegen import output
from tools.codegen.application import ApplicationRenderer
from tools.codegen.output import format_codes
from tools.codegen.spec import ApplicationSpec, SpecError
from tools.codegen.write import hand_written, write

GENERATED = "# Generated by tools.codegen from some/spec.yaml. Do not edit.\n"


def test_a_hand_written_file_is_refused_and_left_untouched(tmp_path: Path) -> None:
    target = tmp_path / "item.py"
    target.write_text("class Hand:\n    pass\n", encoding="utf-8")

    with pytest.raises(SpecError, match="written by hand"):
        write({target: GENERATED + "class Generated:\n    pass\n"})

    assert target.read_text(encoding="utf-8") == "class Hand:\n    pass\n"


def test_a_generated_file_is_not_taken_for_a_hand_written_one(tmp_path: Path) -> None:
    target = tmp_path / "item.py"
    target.write_text(GENERATED + "class Generated:\n    pass\n", encoding="utf-8")

    assert hand_written({target: "class Generated:\n    pass\n"}) == []


def test_an_empty_file_list_runs_no_ruff(monkeypatch: pytest.MonkeyPatch) -> None:
    calls: list[list[str]] = []
    monkeypatch.setattr(output, "run_ruff", calls.append)

    assert format_codes({}) == {}
    assert calls == []


def renderer() -> ApplicationRenderer:
    return ApplicationRenderer("demo", Path("item.yaml"), ApplicationSpec(version=1), Path())


def test_enum_values_that_name_one_member_are_refused() -> None:
    with pytest.raises(SpecError, match="same member"):
        renderer().enum_code("ItemState", ["open", "OPEN"])


@pytest.mark.parametrize(
    ("settings", "prefix"),
    [("HTTPClientSettings", "HTTP_CLIENT_"), ("UserDBSettings", "USER_DB_"), ("ItemStoreSettings", "ITEM_STORE_")],
)
def test_settings_prefix_splits_acronyms_as_one_word(settings: str, prefix: str) -> None:
    assert f'env_prefix="{prefix}"' in renderer().settings_code("IPort", settings)
