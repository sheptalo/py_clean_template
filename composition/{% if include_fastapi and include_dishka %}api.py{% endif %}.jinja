import sys
from collections.abc import AsyncIterator
from contextlib import asynccontextmanager

import uvicorn
from dishka import Provider
from dishka.integrations.fastapi import FastapiProvider, setup_dishka
from fastapi import FastAPI
from fastapi.middleware.cors import CORSMiddleware

from composition.bootstrap.container import make_container
{%- if auto_wire_ports %}
from composition.bootstrap.ports import PortProvider
{%- endif %}
from composition.settings import AppSettings
{%- if auto_wire_ports %}

from {{ project_name }}.presentation import fastapi as fastapi_presentation
{%- endif %}
{%- if codegen_fastapi %}
{% if not auto_wire_ports %}
{% endif %}from {{ project_name }}.presentation.fastapi.generated import exception_handlers, routers
{%- endif %}


@asynccontextmanager
async def lifespan(app: FastAPI) -> AsyncIterator[None]:
    yield
    await app.state.dishka_container.close()


def create_app(*providers: Provider) -> FastAPI:
    """providers go last; one that replaces a registration says provide(..., override=True), as tests' fakes do."""
{%- if codegen_fastapi %}
    app = FastAPI(title="{{ project_name }}", lifespan=lifespan, exception_handlers=exception_handlers)
    for router in routers:
        app.include_router(router)
{%- else %}
    app = FastAPI(title="{{ project_name }}", lifespan=lifespan)
{%- endif %}
    settings = AppSettings()
    origins = [origin.strip() for origin in settings.cors.origins.split(",") if origin.strip()]
    if origins:
        app.add_middleware(CORSMiddleware, allow_origins=origins, allow_methods=["*"], allow_headers=["*"])
{%- if auto_wire_ports %}
    setup_dishka(make_container(FastapiProvider(), PortProvider(fastapi_presentation), *providers), app)
{%- else %}
    setup_dishka(make_container(FastapiProvider(), *providers), app)
{%- endif %}
    return app


def main() -> None:
    uvicorn.main(
        ["--factory", "composition.api:create_app", *sys.argv[1:]],
        prog_name="api",
    )
