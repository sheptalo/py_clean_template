{% if auto_wire_ports -%}
import inspect
from collections.abc import Callable
from types import ModuleType

from dishka import AnyOf, Provider, Scope
from pydantic_settings import BaseSettings

from composition.bootstrap.utils import get_children, load_packages
from {{ project_name }} import infrastructure
from {{ project_name }}.application.interfaces.port import IPort


def ports_of(cls: type) -> list[type]:
    return [base for base in cls.__mro__[1:] if issubclass(base, IPort) and inspect.isabstract(base)]


def settings_factory[T: BaseSettings](cls: type[T]) -> Callable[[], T]:
    def load() -> T:
        return cls()

    return load


class PortProvider(Provider):
    def __init__(self, *packages: ModuleType) -> None:
        super().__init__()
        for package in packages:
            load_packages(package)
        prefixes = tuple(f"{package.__name__}." for package in packages)
        declared = {factory.provides.type_hint for factory in self.factories}
        for cls in get_children(IPort):
            ports = [port for port in ports_of(cls) if port not in declared]
            if cls.__module__.startswith(prefixes) and ports and not inspect.isabstract(cls):
                self.provide(cls, scope=Scope.REQUEST, provides=AnyOf[*ports])
        for settings in get_children(BaseSettings):
            if settings.__module__.startswith(prefixes) and settings not in declared:
                self.provide(settings_factory(settings), scope=Scope.APP, provides=settings)


class InfrastructureProvider(PortProvider):
    def __init__(self) -> None:
        super().__init__(infrastructure)
