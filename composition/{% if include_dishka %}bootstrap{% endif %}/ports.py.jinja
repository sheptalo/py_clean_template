def ports_of(cls: type) -> list[type]:
    return [base for base in cls.__mro__[1:] if issubclass(base, IPort) and inspect.isabstract(base)]


class PortProvider(Provider):
    """Регистрирует реализации портов (наследников IPort), scope — REQUEST.

    Порт, объявленный здесь через provide(), авто-wiring пропускает: так
    задаётся другой scope или выбирается одна из реализаций порта.
    """
{%- if include_example %}

    item_repository = provide(InMemoryItemRepository, scope=Scope.APP, provides=IItemRepository)
{%- endif %}

    def __init__(self) -> None:
        super().__init__()
        declared = {factory.provides.type_hint for factory in self.factories}
        for cls in get_children(IPort):
            ports = [port for port in ports_of(cls) if port not in declared]
            if ports and not inspect.isabstract(cls):
                self.provide(cls, scope=Scope.REQUEST, provides=AnyOf[*ports])
